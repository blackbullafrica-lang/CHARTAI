# AI analysis
GEMINI_API_KEY=your_gemini_api_key

# Optional alternative supported Gemini model
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash

# Venice AI chat (server-side only)
VENICE_API_KEY=your_venice_api_key
VENICE_API_URL=https://api.venice.ai/api/v1
VENICE_MODEL=zai-org-glm-4.7-flash

# Public exchange market data
BINANCE_API_URL=https://data-api.binance.vision
BYBIT_API_URL=https://api.bytick.com
OKX_API_URL=https://www.okx.com
ASTER_API_URL=https://fapi.asterdex.com
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
MEXC_API_URL=https://api.mexc.com

# Supabase project used by shared demo copy trading
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Shared demo copy trading (server-side only; never expose the service role key to the browser)
SUPABASE_SERVICE_ROLE_KEY=
DEMO_TRADING_SECRET=

